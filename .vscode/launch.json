{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CofiPointe — Chrome (web, API locale)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["-d", "chrome"]
    },
    {
      "name": "CofiPointe — Chrome + API_BASE_URL",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "chrome",
        "--dart-define=API_BASE_URL=http://localhost:8000/api/mobile"
      ]
    }
  ]
}
